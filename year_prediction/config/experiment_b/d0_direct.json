{
  "execution": {
    "aggregation": "direct_reduce",
    "batch_fraction": 1.0,
    "broadcast_weights": false,
    "persist_training_data": false
  },
  "feature_manifest": "parquets/year_prediction/training/t90/manifest.json",
  "gradient_tolerance": 1e-08,
  "initialization": "zero_weights_train_mean_intercept",
  "input": "parquets/year_prediction/training/t90/vectors.parquet",
  "l2": 0.001,
  "learning_rate": 0.08,
  "max_iterations": 100,
  "model_id": "d0-direct",
  "objective": "ridge_squared",
  "output_root": "parquets/year_prediction/models",
  "prediction_partitions": 8,
  "shuffle_partitions": 32,
  "validation_interval": 5
}
