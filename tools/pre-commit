#!/bin/bash

STAGED_FILES=$(git diff --cached --name-only --diff-filter=ACM)
[ -z "$STAGED_FILES" ] && exit 0
FAILED=0

# non-ASCII characters
for FILE in $STAGED_FILES; do
  [ -f "$FILE" ] && LC_ALL=C grep -q '[^[:print:][:space:]]' "$FILE" 2>/dev/null && {
    echo "Error: non-ASCII found in $FILE"
    FAILED=1
  }
done

# total changed lines limit (75 lines) for .scala and .java files
TARGET_FILES=$(echo "$STAGED_FILES" | tr ' ' '\n' | grep -E '\.(scala|java)$')
if [ -n "$TARGET_FILES" ]; then
  TOTAL_LINES=$(($(git diff --cached -- $TARGET_FILES | grep -c '^+' || echo 0) - $(echo "$TARGET_FILES" | wc -w)))
  if [ $TOTAL_LINES -gt 75 ]; then
    echo "Error: commit has $TOTAL_LINES changed lines in .scala/.java files (max 75)"
    FAILED=1
  fi
fi

[ $FAILED -eq 1 ] && exit 1
exit 0
